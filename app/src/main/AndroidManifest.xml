<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" >

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Rey3Tie_Mobiel" >

        <!-- ✅ BaseActivity jadi LAUNCHER (halaman pertama) -->
        <activity
            android:name=".SplashScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.Rey3Tie_Mobiel"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SplashScreenActivity tidak lagi jadi launcher -->
        <activity
            android:name=".BaseActivity"
            android:exported="false" />

        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />


        <activity
            android:name=".AuthActivity"
            android:exported="false" />


        <activity android:name=".Home.pertemuan_4.FourthActivity" />

        <activity android:name=".Home.pertemuan_5.FifthActivity" />

        <activity
            android:name=".Home.pertemuan_5.WebViewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".Home.pertemuan_6.SixthActivity"
            android:exported="false" />

    </application>

</manifest>